{
  "name": "newses.app",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/newses-app/newses.app"
  },
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "docs:pull": "node scripts/pull-app-docs.ts",
    "dev": "pnpm docs:pull && vitepress dev",
    "build": "pnpm docs:pull && vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  }
}
